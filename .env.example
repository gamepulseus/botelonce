# ===== API-Football v3 =====
# Tu API key de api-football.com
API_FOOTBALL_KEY=cbb0f106154c72d158f3de7d4db9f27b
# URL base (no cambiar a menos que api-football lo indique)
API_FOOTBALL_URL=https://v3.football.api-sports.io

# ===== Telegram =====
# Token del bot creado con @BotFather (formato: 123456789:ABCdefGhi...)
TELEGRAM_BOT_TOKEN=
# @username del canal público (con @ incluida) o ID numérico (-100...) si es privado
TELEGRAM_CHANNEL=@tu_canal_de_futbol

# ===== Comportamiento =====
# Intervalo de polling en segundos (recomendado: 60)
POLL_INTERVAL_SECONDS=60
# Ligas a monitorear (IDs separados por coma)
# 39 = Premier League (Inglaterra)
# 140 = La Liga (España)
# 135 = Serie A (Italia)
# 78 = Bundesliga (Alemania)
# 61 = Ligue 1 (Francia)
LEAGUES=39,140,135,78,61
# Zona horaria para mostrar horarios de partidos (formato IANA)
TIMEZONE=America/Caracas
# Idioma de los mensajes: es | en
LANGUAGE=es
# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Archivo de persistencia de estado
STATE_FILE=state.json
